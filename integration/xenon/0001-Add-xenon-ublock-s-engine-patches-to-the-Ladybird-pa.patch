diff --git a/Patches/ladybird/0008-RequestServer-LibWeb-Uncloak-CNAMEs-for-the-content-.patch b/Patches/ladybird/0008-RequestServer-LibWeb-Uncloak-CNAMEs-for-the-content-.patch
