 LADYBIRD_SOURCE_DIR = XENON_SOURCE_DIR / "ladybird"
 BUILD_ROOT_DIR = XENON_SOURCE_DIR / "Build"
+# Ladybird with xenon-ublock's engine patches applied (see prepare_ladybird_source()). The ladybird submodule stays as
+# it is; this copy is what gets built.
+PATCHED_LADYBIRD_SOURCE_DIR = BUILD_ROOT_DIR / "ladybird-patched"
 
 if not (LADYBIRD_SOURCE_DIR / "Meta" / "ladybird.py").exists():
     print("The ladybird submodule is missing. Run: git submodule update --init --depth 1", file=sys.stderr)
@@ -105,12 +108,56 @@ def configure_build_env(preset: str, jobs: str | None) -> tuple[Path, Path]:
     return build_dir, vcpkg_dir
 
 
+def find_xenon_ublock() -> Path:
+    candidates = [Path(os.environ["XENON_UBLOCK_DIR"])] if "XENON_UBLOCK_DIR" in os.environ else []
+    candidates += [XENON_SOURCE_DIR / "xenon-ublock", XENON_SOURCE_DIR.parent / "xenon-ublock"]
+    for candidate in candidates:
+        if (candidate / "engine" / "apply.py").exists():
+            return candidate
+    sys.exit(
+        "Xenon builds Ladybird with xenon-ublock's engine patches (uBlock Origin's scriptlets, surrogates, popup and "
+        "CNAME blocking, the element picker), and can't find xenon-ublock. Clone it next to Xenon, as ../xenon-ublock, "
+        "or point XENON_UBLOCK_DIR at it."
+    )
+
+
+def prepare_ladybird_source() -> Path:
+    # Refreshes the patched copy of Ladybird. It is a no-op when neither the submodule nor the patches changed.
+    run_command(
+        [
+            sys.executable,
+            find_xenon_ublock() / "engine" / "apply.py",
+            "--ladybird",
+            LADYBIRD_SOURCE_DIR,
+            "--into",
+            PATCHED_LADYBIRD_SOURCE_DIR,
+        ]
+    )
+    return PATCHED_LADYBIRD_SOURCE_DIR
+
+
+def configured_source_dir(build_dir: Path) -> Path | None:
+    cache = build_dir / "CMakeCache.txt"
+    if not cache.exists():
+        return None
+    for line in cache.read_text().splitlines():
+        if line.startswith("CMAKE_HOME_DIRECTORY:INTERNAL="):
+            return Path(line.partition("=")[2])
+    return None
+
+
 def configure_main(platform: Platform, preset: str, cc: str, cxx: str, jobs: str | None) -> Path:
     build_dir, vcpkg_dir = configure_build_env(preset, jobs)
     build_vcpkg(vcpkg_dir)
+    source_dir = prepare_ladybird_source()
 
     if build_dir.joinpath("build.ninja").exists():
-        return build_dir
+        if configured_source_dir(build_dir) == source_dir:
+            return build_dir
+        # A build configured from the submodule, from before Xenon applied xenon-ublock's patches.
+        print(f"Reconfiguring {build_dir.name} to build {source_dir.relative_to(XENON_SOURCE_DIR)}")
+        build_dir.joinpath("CMakeCache.txt").unlink()
+        shutil.rmtree(build_dir / "CMakeFiles", ignore_errors=True)
 
     cc, cxx = pick_host_compiler(platform, cc, cxx)
 
