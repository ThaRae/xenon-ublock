{
  "presets": {
    "ubo": {
      "title": "uBlock Origin defaults",
      "description": "The lists stock uBlock Origin enables on install.",
      "assets": "https://raw.githubusercontent.com/gorhill/uBlock/master/assets/assets.json"
    },
    "helium": {
      "title": "Helium defaults",
      "description": "The lists Helium's uBlock Origin fork (imputnet/uBlock) enables on install: uBO's defaults plus AdGuard Ads, cookie-notice and annoyance lists, URL tracking protection, and Helium's own fixes.",
      "assets": "https://raw.githubusercontent.com/imputnet/uBlock/main/assets/assets.json"
    }
  },

  "ublock": {
    "_comment": "uBlock Origin release whose scriptlets and redirect resources the patched engine loads. Helium pins the same version.",
    "version": "1.75.0",
    "source": "https://github.com/gorhill/uBlock/archive/refs/tags/{version}.tar.gz"
  },

  "environment": {
    "_comment": "Values for uBO's !#if tokens. Ladybird is not Chromium, Firefox, Safari or a mobile build. Its cosmetic CSS is a user-origin style sheet, so cap_user_stylesheet holds. It cannot filter HTML or match IP addresses. Tokens not listed here are false, as in uBO.",
    "ext_ublock": true,
    "cap_user_stylesheet": true,
    "ext_ubol": false,
    "ext_devbuild": false,
    "env_chromium": false,
    "env_edge": false,
    "env_firefox": false,
    "env_legacy": false,
    "env_mobile": false,
    "env_mv3": false,
    "env_safari": false,
    "cap_html_filtering": false,
    "cap_ipaddress": false,
    "false": false
  },

  "licenses": {
    "_comment": "Licenses of the upstream lists, keyed by uBO asset id. build.py also records each list's own '! License:' header. Lists without an entry are reported as needing review.",
    "ublock-filters": { "license": "GPL-3.0", "url": "https://github.com/uBlockOrigin/uAssets/blob/master/LICENSE" },
    "ublock-badware": { "license": "GPL-3.0", "url": "https://github.com/uBlockOrigin/uAssets/blob/master/LICENSE" },
